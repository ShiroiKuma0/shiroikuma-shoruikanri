<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ 白い熊 fork: the 白い熊 theme, applied as an overlay on every activity (see AppActivity).
  ~
  ~ It holds no colour. Every colour attribute upstream's layouts and Material's widgets read
  ~ is pointed at a role colour resource (@color/sk_role_…, sk_roles.xml), whose value comes
  ~ from the role table at run time (skui/SkPalette.kt). Buttons, switches, selection marks and
  ~ menu rows are drawn in code from their roles (skui/SkViewInflater.kt and friends); the
  ~ styles below give them their shape only.
  -->
<resources>

    <style name="ThemeOverlay.Sk" parent="">
        <item name="android:windowBackground">@color/sk_role_background</item>
        <item name="android:colorBackground">@color/sk_role_background</item>
        <item name="colorSurface">@color/sk_role_surface</item>
        <item name="colorOnSurface">@color/sk_role_text</item>
        <item name="colorOnBackground">@color/sk_role_text</item>
        <!-- The M3 surface-container roles too: dialogs and other elevated surfaces read
             these instead of colorSurface under Material 3. -->
        <item name="colorSurfaceContainerLowest">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerLow">@color/sk_role_surface</item>
        <item name="colorSurfaceContainer">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sk_role_surface</item>
        <item name="colorSurfaceContainerHighest">@color/sk_role_surface</item>
        <item name="colorSurfaceBright">@color/sk_role_surface</item>
        <item name="colorSurfaceDim">@color/sk_role_surface</item>
        <item name="colorSurfaceVariant">@color/sk_role_surface</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_text_secondary</item>
        <item name="colorAppBarSurface">@color/sk_role_app_bar</item>
        <item name="textColorAlertDialogListItem">@color/sk_text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/sk_text_primary</item>
        <item name="colorPrimary">@color/sk_role_accent</item>
        <item name="colorPrimaryVariant">@color/sk_role_accent</item>
        <item name="colorSecondary">@color/sk_role_accent</item>
        <item name="colorSecondaryVariant">@color/sk_role_accent</item>
        <item name="colorAccent">@color/sk_role_accent</item>
        <item name="colorOnPrimary">@color/sk_role_on_accent</item>
        <item name="colorOnSecondary">@color/sk_role_on_accent</item>
        <item name="colorPrimaryContainer">@color/sk_role_selected</item>
        <item name="colorOnPrimaryContainer">@color/sk_role_on_selected</item>
        <item name="colorSecondaryContainer">@color/sk_role_selected</item>
        <item name="colorOnSecondaryContainer">@color/sk_role_on_selected</item>
        <item name="colorError">@color/sk_role_danger</item>
        <item name="colorControlNormal">@color/sk_role_icon</item>
        <item name="colorControlActivated">@color/sk_role_icon_active</item>
        <item name="colorControlHighlight">@color/sk_role_pressed</item>
        <item name="android:textColorPrimary">@color/sk_text_primary</item>
        <item name="android:textColorSecondary">@color/sk_text_secondary</item>
        <item name="android:textColorTertiary">@color/sk_role_text_tertiary</item>
        <item name="android:textColorHint">@color/sk_role_text_hint</item>
        <item name="android:textColorHighlight">@color/sk_role_text_selection</item>
        <item name="android:textColorLink">@color/sk_role_link</item>
        <item name="android:editTextColor">@color/sk_role_field_text</item>
        <item name="editTextColor">@color/sk_role_field_text</item>
        <item name="android:listDivider">@drawable/sk_list_divider</item>
        <item name="colorOutline">@color/sk_role_outline</item>
        <!-- No elevation overlay: in dark themes it tints elevated surfaces (menus, dialogs)
             with colorOnSurface — see-through text colour. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Popup menus: the menu ground inside the menu frame. Their rows are
             skui/SkPillMenuItemView. -->
        <item name="popupMenuBackground">@drawable/sk_popup_background</item>
        <item name="popupMenuStyle">@style/Widget.Sk.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Sk.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Sk.ListPopupWindow</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Sk.PopupMenu.Overflow</item>
        <!-- AppCompat-built dialogs (preference dialogs) get the panel from their window;
             Material dialogs get it from SkMaterialAlertDialogBuilder. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Sk.AlertDialog</item>
        <!-- Every button is a pill: the shape here, the colours and the weight of the main
             action in skui/SkViewInflater. -->
        <item name="materialButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Sk.Pill</item>
        <item name="borderlessButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
        <!-- The one place every inflated button, switch, check box and radio button passes
             through. -->
        <item name="viewInflaterClass">me.zhanghai.android.files.skui.SkViewInflater</item>
    </style>

    <style name="ThemeOverlay.Sk.AlertDialog" parent="@style/ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/sk_dialog_background</item>
        <item name="colorOnSurface">@color/sk_role_dialog_title</item>
        <item name="android:textColorPrimary">@color/sk_role_dialog_text</item>
        <item name="android:textColorSecondary">@color/sk_role_dialog_text</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_dialog_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
    </style>

    <!-- Layered by SkMaterialAlertDialogBuilder over the Material dialog theme, which would
         otherwise put its own bare-text buttons and its own text colours back. -->
    <style name="ThemeOverlay.Sk.MaterialAlertDialog" parent="">
        <item name="colorOnSurface">@color/sk_role_dialog_title</item>
        <item name="android:textColorPrimary">@color/sk_role_dialog_text</item>
        <item name="android:textColorSecondary">@color/sk_role_dialog_text</item>
        <item name="colorOnSurfaceVariant">@color/sk_role_dialog_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sk.Pill.Main</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sk.Pill</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sk.Pill</item>
    </style>

    <!-- A dialog that deletes: its main button takes the danger role. -->
    <style name="ThemeOverlay.Sk.MaterialAlertDialog.Destructive">
        <item name="skDestructiveDialog">true</item>
    </style>

    <!-- The pill: fully round, a frame, the ground showing through. Shape only — frame,
         label and ground are roles, applied by skui/SkViewInflater (see skui/SkPill.kt for
         views built in code). -->
    <style name="Widget.Sk.Pill" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="strokeWidth">1.25dp</item>
        <item name="cornerRadius">100dp</item>
    </style>

    <style name="Widget.Sk.Pill.Main">
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">3dp</item>
    </style>

    <style name="Widget.Sk.PopupMenu" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>

    <style name="Widget.Sk.PopupMenu.Overflow" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>

    <style name="Widget.Sk.ListPopupWindow" parent="@style/Widget.MaterialComponents.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/sk_popup_background</item>
    </style>
</resources>
