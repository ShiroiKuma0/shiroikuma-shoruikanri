<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ 白い熊 fork: the colour ROLES, as resources.
  ~
  ~ Every name here is fed by one role of the role table in code (skui/SkThemeSlot.kt, through
  ~ skui/SkPalette.kt): from Android 11 on, SkPalette lays a resources loader over the app that
  ~ gives each name the colour its role has — the one 白い熊 set on the UI page, or the
  ~ role's default.
  ~
  ~ The values in this file are what a system WITHOUT that loader shows (Android 6 to 10): each
  ~ role's default, computed from the two primaries exactly as SkThemeSlot.skDefault() does. They
  ~ are a copy, kept for those systems only — the role table in code stays the one place a
  ~ default is decided, and a default changed there must be changed here too. (Until 1.7.5+010
  ~ they were placeholders, a magenta ground and a pink ink; 白い熊 chose real defaults on
  ~ 2026-11-22 so that an older system shows the theme and not the placeholders.)
  ~
  ~ Never add a qualified copy of this file (values-night, values-v30, …): a qualified value
  ~ beats the loader.
  -->
<resources>
    <color name="sk_role_background">#FF000000</color>
    <color name="sk_role_surface">#FF000000</color>
    <color name="sk_role_on_accent">#FF000000</color>
    <color name="sk_role_selected">#FF404000</color>
    <color name="sk_role_app_bar">#FF000000</color>
    <color name="sk_role_dialog_ground">#FF000000</color>
    <color name="sk_role_menu_ground">#FF000000</color>
    <color name="sk_role_accent">#FFFFFF00</color>
    <color name="sk_role_text">#FFFFFF00</color>
    <color name="sk_role_text_disabled">#60FFFF00</color>
    <color name="sk_role_text_secondary">#B2FFFF00</color>
    <color name="sk_role_text_secondary_disabled">#4CFFFF00</color>
    <color name="sk_role_text_tertiary">#7FFFFF00</color>
    <color name="sk_role_text_hint">#7FFFFF00</color>
    <color name="sk_role_text_selection">#59FFFF00</color>
    <color name="sk_role_link">#FFFFFF00</color>
    <color name="sk_role_icon">#FFFFFF00</color>
    <color name="sk_role_icon_active">#FFFFFF00</color>
    <color name="sk_role_pressed">#4CFFFF00</color>
    <color name="sk_role_outline">#FFFFFF00</color>
    <color name="sk_role_field_text">#FFFFFF00</color>
    <color name="sk_role_list_divider">#33FFFF00</color>
    <color name="sk_role_on_selected">#FFFFFF00</color>
    <color name="sk_role_danger">#FFFF0000</color>
    <color name="sk_role_dialog_frame">#FFFFFF00</color>
