<?xml version="1.0" encoding="utf-8"?>

<!-- 白い熊 fork: the panel of a popup menu, read by the platform from the theme — the menu
     ground inside the menu frame, both roles. -->
<!-- Android 6 only: from Android 7 on drawable-v24/sk_popup_background.xml draws this in code. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/sk_role_menu_ground" />
    <stroke
        android:width="1dp"
        android:color="@color/sk_role_menu_frame" />
    <corners android:radius="8dp" />
</shape>
