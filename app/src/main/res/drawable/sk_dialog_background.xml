<?xml version="1.0" encoding="utf-8"?>

<!-- 白い熊 fork: the panel of a dialog the platform builds from the theme (a preference
     dialog) — the dialog ground inside the dialog frame, both roles. Dialogs the fork builds
     get the same panel in code (skui/SkPill.kt, skPanel). -->
<!-- Android 6 only: from Android 7 on drawable-v24/sk_dialog_background.xml draws this in code. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/sk_role_dialog_ground" />
    <stroke
        android:width="1dp"
        android:color="@color/sk_role_dialog_frame" />
    <corners android:radius="12dp" />
</shape>
