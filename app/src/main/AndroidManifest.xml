        <!--
          ~ 白い熊 fork: the sister-app 保存復元 automation contract — a headless
          ~ category-ZIP export (EXPORT_STATE), the category enumeration
          ~ (LIST_CATEGORIES), and the stop 白い熊 presses from the panel that
          ~ started it (CANCEL_EXPORT).
          ~
          ~ No android:permission, and in contract v2 that is deliberate rather than
          ~ forced: this receiver is the UNAUTHENTICATED half of the surface — it only
          ~ ever writes where it was told to and reports what it did. Everything that
          ~ moves data through a caller-supplied descriptor lives behind
          ~ SkAutomationProvider below, which knows who is calling.
          ~
          ~ CANCEL_EXPORT lives here rather than on the service because the service is
          ~ (correctly) not exported and a third-party app cannot start it; the receiver
          ~ signals the running export internally.
          -->
        <receiver
            android:name="me.zhanghai.android.files.skui.SkStateExportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.EXPORT_STATE" />
                <action android:name="${applicationId}.action.LIST_CATEGORIES" />
                <action android:name="${applicationId}.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <!--
          ~ 白い熊 fork (contract v2 §2a): the data door. 応用管理 backs this app up WITH
          ~ its data and puts it back on a wiped phone, moving the bytes through a
          ~ descriptor IT opened — never a path we resolve. Exported with no permission on
          ~ purpose: a custom permission would have to be "normal" (any app may hold it) or
          ~ "signature" (impossible — every app in this family has its own keystore), and
          ~ neither buys anything SkAutomationCallers' name + uid + pinned-certificate check
          ~ does not.
          ~
          ~ Declared AFTER AppProvider: this app builds its entire global state in
          ~ AppProvider.onCreate(), and Android creates providers in manifest order.
          -->
        <provider
            android:name="me.zhanghai.android.files.skui.SkAutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true" />

        <service
            android:name="me.zhanghai.android.files.skui.SkAutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!--
          ~ Capability discovery, read with MATCH_UNINSTALLED_PACKAGES |
          ~ MATCH_DISABLED_COMPONENTS. Manifest meta-data rather than a query intent
          ~ because a FROZEN app cannot be asked anything, and 白い熊 freezes aggressively —
          ~ 応用管理 must still answer "can this app be backed up" for a disabled package.
          ~ An app without these is simply not offered for data backup or restore.
          -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>
</manifest>
